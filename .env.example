# 复制本文件为 .env 再填写；.env 已在 .gitignore 里，不会被提交。
# 填完任何一项后，重新运行 `uv run alf service install` 让后台服务读到新配置，再用 `uv run alf doctor` 检查。

# ---------- 模型 ----------
# DeepSeek：负责听懂你的话、整理记忆、像朋友一样回复。https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# 默认 deepseek-flash（便宜、能看图）；更强但更贵的是 deepseek-v4-pro
# DEEPSEEK_MODEL=deepseek-flash

# Jev（可选）：填了就由它做"是不是 / 选哪个"这类快速判断；不填则这些判断也交给 DeepSeek。
# https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=
# TYPESAFE_DEFAULT_MODEL=jev-1.13.0
# 仅当 key 来自第三方网关而非 console.typesafe.ai 时才需要改
# TYPESAFE_BASE_URL=

# ---------- iMessage ----------
# 你自己的 iMessage 地址：Alf 只听这个地址的话，也只给它发消息。
# 手机号写成 +61412345678 这种带国家码的形式，或者写你的 Apple ID 邮箱；
# 以 iPhone「设置 → 信息 → 发送与接收 → 开始新对话时使用」里选中的那个为准。
ALF_IMESSAGE_OWNER=
# 每晚几点发"今天我记下了这些"；填 off 关闭
# ALF_DIGEST_AT=21:30

ALF_TZ=Australia/Sydney
# Whisper 模型：tiny / base / small / medium / large-v3-turbo（越大越准越慢）
ALF_ASR_MODEL=small
# 留空 = 自动检测语言（中英混说时更准）；强制中文填 zh
ALF_ASR_LANGUAGE=

# ---------- 常驻服务（alf serve）----------
# 网页端口
# ALF_WEB_PORT=8765
# 每天几点播报当天剩下的安排；填 off 关闭
# ALF_BRIEFING_AT=08:00
# 多久检查一次到期提醒（秒），也就是提醒最多晚这么久
# ALF_REMINDER_EVERY=10

# ---------- 邮箱 ----------
# 在 Alf 的设置页「邮箱」里填更方便。每个邮箱填地址和"授权码 / 应用专用密码"（不是登录密码），两项都填了才启用。
# Gmail：Google 账号 → 安全性 → 两步验证 → 应用专用密码
ALF_GMAIL_USER=
ALF_GMAIL_PASSWORD=
# 163：网页版 设置 → POP3/SMTP/IMAP → 开启 IMAP/SMTP 服务
ALF_163_USER=
ALF_163_PASSWORD=
# QQ：网页版 设置 → 账号 → 开启 IMAP/SMTP 服务
ALF_QQ_USER=
ALF_QQ_PASSWORD=
# 别的邮箱：手填服务器。HOST、USER、PASSWORD 三项都填了才启用；要能回信再填 SMTP_HOST。
# ALF_EMAIL_HOST=imap.mail.me.com
# ALF_EMAIL_USER=
# ALF_EMAIL_PASSWORD=
# ALF_EMAIL_SMTP_HOST=smtp.mail.me.com
# 多久查一次新邮件（秒）
# ALF_EMAIL_EVERY=300
# off = 不把邮件内容发给 Jev 判断，新邮件一律通知
# ALF_EMAIL_TRIAGE=on
# Jev 认为"需要你处理"的概率达到多少才通知
# ALF_EMAIL_NOTIFY_THRESHOLD=0.6
